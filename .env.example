# Copy to .env for local development:  cp .env.example .env
# Never commit the real .env. On Render, set these in the dashboard.

# HTTP server port (Render injects its own PORT automatically).
PORT=8080

# API key that clients must send as the  X-API-Key  header.
# Leave empty to disable auth (not recommended for a public deployment).
API_KEY=

# Full Cookie header copied from a logged-in LinkedIn browser session.
# Use a burner account. Must contain at least li_at, JSESSIONID and lidc.
# See the README "Configuration" section for how to obtain this.
LINKEDIN_COOKIE=

# The JSESSIONID value (e.g. ajax:1234567890). The app derives the
# csrf-token header from it. If omitted, it is read from LINKEDIN_COOKIE.
JSESSIONID=

# Browser User-Agent to send with every LinkedIn request. Ideally match the
# browser you copied the cookie from.
LINKEDIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Optional outbound proxy for LinkedIn requests, e.g.
#   http://user:pass@residential-proxy.example.com:8000
# LinkedIn aggressively rate-limits datacenter IP ranges (AWS/GCP/Render), so
# a residential/mobile proxy is the reliable fix for a cloud deployment.
# Falls back to HTTPS_PROXY if unset.
LINKEDIN_PROXY=

# Response cache TTL. 0 disables caching.
CACHE_TTL=24h
